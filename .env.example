# 玉珍健身后端 - 环境变量模板
# Laravel Backend Environment Template
# 更新日期：2026-01-18
# 
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写所有必需的环境变量值
# 3. 敏感信息（密码、密钥）必须使用强密码
# 4. 生产环境通过Zeabur控制台配置敏感变量

# ==================== 应用基础配置 ====================

APP_NAME="Yuzhen Fitness Backend"
APP_ENV=local
# 必须设置：使用 php artisan key:generate 生成
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ==================== 日志配置 ====================

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==================== 数据库配置 ====================
# 密码要求：至少16字符，包含大小写字母、数字和特殊字符

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitness_app
DB_USERNAME=
# 必须设置：数据库密码（强密码要求）
DB_PASSWORD=

# ==================== 缓存/会话/队列配置 ====================

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# ==================== Redis配置 ====================

REDIS_HOST=redis
REDIS_PORT=6379
# 可选：Redis密码（生产环境建议设置）
REDIS_PASSWORD=

# ==================== 邮件配置 ====================

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
# 必须设置：邮件服务密码
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="玉珍健身"

# 邮箱验证码过期时间（秒）
MAIL_VERIFICATION_CODE_EXPIRE=300

# ==================== AWS配置（可选）====================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==================== Pusher配置（可选）====================

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ==================== CORS配置 ====================

CORS_ALLOWED_ORIGINS="http://localhost:9000,http://localhost:5173"

# ==================== DAML-RAG服务配置 ====================

MCO_BASE_URL=http://localhost:8001
DAML_RAG_URL=http://localhost:8001

# ==================== JWT配置 ====================
# 必须设置：使用强随机字符串，至少64字符

JWT_SECRET=

# ==================== 内部API认证 ====================
# 必须设置：内部服务通信Token，至少32字符

INTERNAL_API_TOKEN=

# ==================== Internal JWT配置（服务间通信） ====================
# 内部JWT密钥（至少32字符，必须与JWT_SECRET不同）
INTERNAL_JWT_SECRET=
# 内部JWT过期时间（秒，不超过60）
INTERNAL_JWT_TTL=60
# 内部JWT签发者标识
INTERNAL_JWT_ISSUER=yuzhen-auth-gateway

# ==================== 阿里云短信配置 ====================

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_CODE_REGISTER=
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=
ALIYUN_SMS_TEMPLATE_CODE_RESET=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_CODE_EXPIRE=300

# ==================== 会员系统配置 ====================

# 会员系统开关（Feature Flag）
# false: 开发测试阶段，所有用户获得ENERGY级别权限
# true: 商业化阶段，根据实际会员等级分配权限
MEMBERSHIP_SYSTEM_ENABLED=false

# 开发测试阶段每日限制
DEV_DAILY_DAG_LIMIT=10
DEV_DAILY_AGENT_LIMIT=3

# 会员权限缓存TTL（秒）
MEMBERSHIP_CACHE_TTL=300

# ==================== 安全配置说明 ====================
# 
# 以下变量包含敏感信息，必须妥善保管：
# - APP_KEY: Laravel应用密钥
# - DB_PASSWORD: 数据库密码
# - REDIS_PASSWORD: Redis密码
# - MAIL_PASSWORD: 邮件服务密码
# - JWT_SECRET: JWT签名密钥
# - INTERNAL_API_TOKEN: 内部API认证Token
# - ALIYUN_ACCESS_KEY_SECRET: 阿里云密钥
#
# 密码强度要求：
# - 至少16字符
# - 包含大写字母(A-Z)
# - 包含小写字母(a-z)
# - 包含数字(0-9)
# - 包含特殊字符(!@#$%^&*等)
