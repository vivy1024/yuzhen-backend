# 玉珍健身后端 - Zeabur生产环境配置
# 此文件用于Zeabur部署，环境变量会被Zeabur自动注入的值覆盖

APP_NAME="Yuzhen Fitness Backend"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yuzhenapi.preview.aliyun-zeabur.cn

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============= 数据库配置 =============
# Zeabur会自动注入这些变量，这里只是默认值
DB_CONNECTION=mysql
DB_HOST=${MYSQL_HOST}
DB_PORT=${MYSQL_PORT:-3306}
DB_DATABASE=${MYSQL_DATABASE:-fitness_app}
DB_USERNAME=${MYSQL_USERNAME:-fitness_user}
DB_PASSWORD=${MYSQL_PASSWORD}

# ============= 缓存/会话/队列配置 =============
# 生产环境使用file驱动，避免Redis连接问题影响核心功能
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

# ============= Redis配置 =============
# Zeabur会自动注入REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
# 如果Zeabur没有自动注入，需要在Zeabur控制台手动设置
REDIS_CLIENT=phpredis
REDIS_HOST=${REDIS_HOST:-127.0.0.1}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_PASSWORD=${REDIS_PASSWORD:-null}

# ============= 邮件配置 - Spacemail =============
