# 玉珍健身后端 - Zeabur生产环境配置
# 此文件用于Zeabur部署，环境变量会被Zeabur自动注入的值覆盖

APP_NAME="Yuzhen Fitness Backend"
APP_ENV=production
APP_KEY=base64:gg92SZnkq1krlsydq0M2EtNF+VPMXaxpktgwFb9zHJc=
APP_DEBUG=false
APP_URL=https://yuzhenapi.preview.aliyun-zeabur.cn

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============= 数据库配置 =============
# 使用环境变量占位符，由entrypoint.sh替换为Zeabur注入的值
DB_CONNECTION=mysql
DB_HOST=${DB_HOST}
DB_PORT=3306
DB_DATABASE=fitness_app
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# ============= 缓存/会话/队列配置 =============
# 生产环境使用file驱动，避免Redis连接问题影响核心功能
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

# ============= Redis配置 =============
# 使用Zeabur自动生成的环境变量
REDIS_CLIENT=phpredis
REDIS_HOST=${FITNESS_REDIS_HOST:-fitness-redis.zeabur.internal}
REDIS_PORT=6379
REDIS_PASSWORD=${FITNESS_REDIS_PASSWORD}

# ============= Neo4j配置 =============
# 注意：Zeabur阿里云区域不支持Bolt协议的内网连接
# 必须使用公网端口连接
# 公网端口：32372（从Zeabur控制台Networking标签获取）
NEO4J_URL=bolt://182.92.78.183:32372
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=build_body_2024

# ============= Qdrant配置 =============
# 使用Zeabur内网域名
QDRANT_URL=http://${FITNESS_QDRANT_HOST:-fitness_qdrant.zeabur.internal}:6333

# ============= 邮件配置 - Spacemail =============
MAIL_MAILER=smtp
MAIL_HOST=mail.spacemail.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@xxc1024.site
MAIL_PASSWORD=Xxxc3294553478.
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@xxc1024.site
MAIL_FROM_NAME="玉珍健身"
MAIL_VERIFICATION_CODE_EXPIRE=300

# ============= CORS配置 =============
CORS_ALLOWED_ORIGINS="https://yuzhen.preview.aliyun-zeabur.cn,https://yuzhen-fitness.cn"

# ============= DAML-RAG服务配置 =============
# 注意：Zeabur内部域名格式为 服务名.zeabur.internal
# DAML-RAG服务名为 daml-rag-server（不是fitness_daml_rag）
# 端口为 8001
MCO_BASE_URL=http://daml-rag-server.zeabur.internal:8001
DAML_RAG_URL=http://daml-rag-server.zeabur.internal:8001

# ============= JWT配置 =============
JWT_SECRET=RmECwscVklupfO8mr16YDTZiIjrSHo99kgpdg9qfWGs46UWobYaLiGpCbC4DRvxh

# ============= 阿里云短信配置 =============
ALIYUN_ACCESS_KEY_ID=LTAI5t63ZTxgfs16eXSLoYHN
ALIYUN_ACCESS_KEY_SECRET=jYjQrJ4fWEqk67MHSyXiYsylRhSErs
ALIYUN_SMS_SIGN_NAME=云渚科技验证平台
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_TEMPLATE_CODE_REGISTER=100001
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=100001
ALIYUN_SMS_TEMPLATE_CODE_RESET=100003
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_CODE_EXPIRE=300

# ============= 会员自动化控制系统配置 =============
# 会员系统开关（Feature Flag）
# false: 开发测试阶段，所有用户获得ENERGY级别权限，但仍受每日限制
# true: 商业化阶段，根据实际会员等级分配权限
# 个人开发者合规要求，暂时禁用会员系统，获得企业资质后设置为 true
MEMBERSHIP_SYSTEM_ENABLED=false

# 开发测试阶段每日限制
DEV_DAILY_DAG_LIMIT=10
DEV_DAILY_AGENT_LIMIT=3

# 会员权限缓存TTL（秒）
MEMBERSHIP_CACHE_TTL=300

# ============= Internal JWT配置（服务间通信） =============
# 内部JWT密钥（至少32字符，必须与JWT_SECRET不同）
# 生产环境通过Zeabur环境变量覆盖
INTERNAL_JWT_SECRET=CHANGE_ME_IN_ZEABUR_ENV
INTERNAL_JWT_TTL=60
INTERNAL_JWT_ISSUER=yuzhen-auth-gateway
# 是否启用Internal JWT转发（初始false，验证后在Zeabur控制台改为true）
ENABLE_INTERNAL_JWT=false

# 内部API Token（旧模式，ENABLE_INTERNAL_JWT=false时使用）
# 必须与DAML-RAG端的INTERNAL_API_TOKEN一致
INTERNAL_API_TOKEN=9eTioEunbkSpXJc6bEDmxEGKRrCY0p2xl2D6mhXwWaLrv-b63v2IoDYZiH4WzbDw
