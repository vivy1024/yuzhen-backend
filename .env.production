# 玉珍健身后端 - Zeabur生产环境配置
# 敏感值全部由 Zeabur 环境变量注入，此文件不含任何密钥
# entrypoint.sh 会用 sed 替换 ${VAR} 占位符

APP_NAME="Yuzhen Fitness Backend"
APP_ENV=production
APP_KEY=${APP_KEY}
APP_DEBUG=false
APP_URL=${APP_URL:-https://api.yuzhen-fitness.cn}

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============= 数据库配置 =============
DB_CONNECTION=mysql
DB_HOST=${DB_HOST}
DB_PORT=3306
DB_DATABASE=${DB_DATABASE:-fitness_app}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# ============= 缓存/会话/队列配置 =============
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

# ============= Redis配置 =============
REDIS_CLIENT=phpredis
REDIS_HOST=${REDIS_HOST:-fitness-redis.zeabur.internal}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# ============= Neo4j配置 =============
NEO4J_URL=${NEO4J_URL}
NEO4J_USERNAME=${NEO4J_USERNAME:-neo4j}
NEO4J_PASSWORD=${NEO4J_PASSWORD}

# ============= Qdrant配置 =============
QDRANT_URL=${QDRANT_URL:-http://fitness_qdrant.zeabur.internal:6333}

# ============= 邮件配置 - 阿里云DirectMail =============
MAIL_MAILER=smtp
MAIL_HOST=smtpdm.aliyun.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@yuzhen-fitness.cn
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@yuzhen-fitness.cn
MAIL_FROM_NAME="玉珍健身"
MAIL_VERIFICATION_CODE_EXPIRE=300

# ============= CORS配置 =============
CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS:-https://app.yuzhen-fitness.cn,https://yuzhen-fitness.cn}

# ============= DAML-RAG服务配置 =============
MCO_BASE_URL=${DAML_RAG_URL:-http://daml-rag-server.zeabur.internal:8001}
DAML_RAG_URL=${DAML_RAG_URL:-http://daml-rag-server.zeabur.internal:8001}

# ============= JWT配置 =============
JWT_SECRET=${JWT_SECRET}

# ============= 阿里云短信配置 =============
ALIYUN_ACCESS_KEY_ID=${ALIYUN_ACCESS_KEY_ID}
ALIYUN_ACCESS_KEY_SECRET=${ALIYUN_ACCESS_KEY_SECRET}
ALIYUN_SMS_SIGN_NAME=${ALIYUN_SMS_SIGN_NAME:-云渚科技验证平台}
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_TEMPLATE_CODE_REGISTER=100001
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=100001
ALIYUN_SMS_TEMPLATE_CODE_RESET=100003
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_CODE_EXPIRE=300

# ============= 会员系统配置 =============
MEMBERSHIP_SYSTEM_ENABLED=false
DEV_DAILY_DAG_LIMIT=10
DEV_DAILY_AGENT_LIMIT=3
MEMBERSHIP_CACHE_TTL=300

# ============= Internal JWT配置（服务间通信） =============
INTERNAL_JWT_SECRET=${INTERNAL_JWT_SECRET}
INTERNAL_JWT_TTL=60
INTERNAL_JWT_ISSUER=yuzhen-auth-gateway
ENABLE_INTERNAL_JWT=false
INTERNAL_API_TOKEN=${INTERNAL_API_TOKEN}
