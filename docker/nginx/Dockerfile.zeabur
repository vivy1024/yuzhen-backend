FROM nginx:alpine

# 安装 envsubst（用于环境变量替换）
RUN apk add --no-cache gettext

# 复制 Nginx 配置模板
COPY docker/nginx/default.conf.zeabur /etc/nginx/templates/default.conf.template

# 创建启动脚本
RUN echo '#!/bin/sh' > /docker-entrypoint-zeabur.sh && \
    echo 'envsubst < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf' >> /docker-entrypoint-zeabur.sh && \
    echo 'exec /docker-entrypoint.sh nginx -g "daemon off;"' >> /docker-entrypoint-zeabur.sh && \
    chmod +x /docker-entrypoint-zeabur.sh

# 设置默认环境变量
ENV PHP_FPM_HOST=php-service \
    PHP_FPM_PORT=9000

# 暴露端口
EXPOSE 80

# 使用自定义启动脚本
ENTRYPOINT ["/docker-entrypoint-zeabur.sh"]



